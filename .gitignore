# Hugo build output
/public/
/resources/_gen/
/resources/_gen/assets/
/resources/_gen/images/
/hugo_stats.json

# Node.js dependencies (if used)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# VS Code
.vscode/

# OS generated files
.DS_Store
Thumbs.db

# IDE/cache/config
.idea/
.playwright-mcp/
*.swp
*.swo
*.swn

# SASS/SCSS cache
.sass-cache/

# Backup files
*~
*.bak

# Environment files
.env
.env.*

# Log files
*.log

# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class
.Python

# Local research / eval dumps (optional --out from revise-spanish, revise-prose, Perplexity notes)
/docs/research/

# Misc
*.local
.hugo_build.lock
.venv-og/
# Local go build -o at repo root (sources live under cmd/)
/linkedin-autopost
/motif-editor

/tmp/

# Local provider repos (symlinks to sibling checkouts; see scripts/link-providers.sh).
# Not a Go module replace: go tool task serve runs MCP via scripts/serve-content-pipelines-mcp.sh.
/providers/

# direnv per-machine allow cache (do not commit)
.direnv/

# Substack automation: never commit Chrome profile directories (cookies, local state).
.cache/substack-chrome-profile/
substack-chrome-profile/
.substack/
ignore.*