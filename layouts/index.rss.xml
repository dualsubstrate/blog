{{- /* Site override: LoveIt filters home RSS to type "posts" only; this site uses claims, video, cows, sayings, etc. */ -}}
<rss xmlns:atom="http://www.w3.org/2005/Atom" xmlns:media="http://search.yahoo.com/mrss/" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:content="http://purl.org/rss/1.0/modules/content/" xmlns:sync="https://blog.dualsubstrate.com/xmlns/rss-sync/1.0" version="2.0">
    <channel>
        <title>
            {{- .Site.Title -}}
        </title>
        <link>
            {{- .Permalink -}}
        </link>
        <description>
            {{- .Site.Params.description | default .Site.Title -}}
        </description>
        {{- /* Feed-level image: RSS channel <image> expects raster (PNG/JPEG/GIF), not SVG */ -}}
        {{- $feedImage := "" -}}
        {{- range (.Site.Params.images | default slice) -}}
            {{- if and (not $feedImage) (not (strings.HasSuffix (lower .) ".svg")) -}}
                {{- $feedImage = . -}}
            {{- end -}}
        {{- end -}}
        {{- if not $feedImage -}}
            {{- with .Site.Params.header.title.logo -}}
                {{- if not (strings.HasSuffix (lower .) ".svg") -}}
                    {{- $feedImage = . -}}
                {{- end -}}
            {{- end -}}
        {{- end -}}
        {{- if not $feedImage -}}
            {{- $feedImage = "/images/og-default.png" -}}
        {{- end -}}
        {{- with $feedImage -}}
            {{- $feedImageAbs := . | absURL -}}
            <image>
                <url>{{ $feedImageAbs }}</url>
                <title>{{ $.Site.Title }}</title>
                <link>{{ $.Permalink }}</link>
            </image>
            <atom:logo>{{ $feedImageAbs }}</atom:logo>
        {{- end -}}
        {{- with .Site.LanguageCode -}}
            <language>
                {{- . -}}
            </language>
        {{- end -}}
        {{- with .Site.Params.Author.email -}}
            <managingEditor>
                {{- . }}{{ with $.Site.Params.Author.name }} ({{ . }}){{ end -}}
            </managingEditor>
            <webMaster>
                {{- . }}{{ with $.Site.Params.Author.name }} ({{ . }}){{ end -}}
            </webMaster>
        {{- end -}}
        {{- with .Site.Copyright -}}
            <copyright>
                {{- . -}}
            </copyright>
        {{- end -}}
        {{- /* Use build time; home/list .Date can be a future publish date and fails feed validators */ -}}
        <lastBuildDate>
            {{- now.Format "Mon, 02 Jan 2006 15:04:05 -0700" -}}
        </lastBuildDate>
        {{ with .OutputFormats.Get "RSS" }}
            {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
        {{ end }}
        {{- $limit := .Site.Params.home.rss | default 10 -}}
        {{- range first $limit .Site.RegularPages.ByDate.Reverse -}}
            {{- dict "Page" . "Site" .Site | partial "rss/item.html" -}}
        {{- end -}}
    </channel>
</rss>
